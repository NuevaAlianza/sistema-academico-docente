{
  "name": "sistema-academico-docente",
  "version": "1.8.2",
  "description": "Sistema de gestión académica para docentes",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build-app": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.nuevaalianza.sistema-academico",
    "productName": "Sistema Académico Docente",
    "copyright": "2025 Nueva Alianza",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sistema Académico"
    },
    "publish": {
      "provider": "github",
      "owner": "NuevaAlianza",
      "repo": "sistema-academico-docente"
    }
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.8.3",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react-router-dom": "^6.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
